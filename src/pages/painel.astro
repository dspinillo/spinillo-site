---
import Base from "../layouts/Base.astro";
import painel from "../data/painel.json";
import Fluxo from "../components/figuras/Fluxo.astro";

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const data = (iso: string) => iso.split("-").reverse().slice(0, 2).join("/");
const opcoes = (k: "familia" | "nivel" | "modelo") => {
  const conta: Record<string, number> = {};
  for (const l of painel.linhas) conta[l[k]] = (conta[l[k]] ?? 0) + 1;
  return Object.entries(conta).sort((a, b) => b[1] - a[1]).map(([n]) => n);
};
const fontes = new Set(painel.linhas.map((l) => l.fonte)).size;
const filtros = [
  { k: "familia", rotulo: "Área", itens: opcoes("familia") },
  { k: "nivel", rotulo: "Nível", itens: opcoes("nivel") },
  { k: "modelo", rotulo: "Modelo", itens: opcoes("modelo") },
];
---
<Base title="O mercado de liderança em operação e dados · Dhiego Spinillo" description="Foto da semana das vagas de liderança em operação, dados, processos e receita no Brasil: ferramentas pedidas, modelo de trabalho e quem contrata.">
  <main>
    <a class="voltar" href={`${base}/#enxergar`}>← Enxergar</a>

    <header class="abertura">
      <p class="rotulo">Painel · coleta de {data(painel.coleta)}</p>
      <h1>O mercado de liderança em operação e dados</h1>
      <p class="resumo">Uma foto das vagas abertas para gerente, head e coordenação em operação, dados, processos e receita: o que pedem, onde é o trabalho e quem está contratando. Filtre para ver a sua fatia.</p>
      <a class="ancora" href="#como">Como o coletor funciona ↓</a>
    </header>

    <div class="filtros" role="group" aria-label="Filtros">
      {filtros.map((f) => (
        <label>
          <span>{f.rotulo}</span>
          <select data-filtro={f.k}>
            <option value="">Todas</option>
            {f.itens.map((i) => <option value={i}>{i}</option>)}
          </select>
        </label>
      ))}
      <button type="button" class="limpar" hidden>Limpar filtros</button>
    </div>

    <dl class="numeros">
      <div><dt>vagas</dt><dd data-n="vagas">{painel.total}</dd></div>
      <div><dt>empresas</dt><dd data-n="empresas">{painel.empresas}</dd></div>
      <div><dt>pedem inglês fluente</dt><dd data-n="ingles">–</dd></div>
      <div><dt>mostram o salário</dt><dd data-n="salario">–</dd></div>
    </dl>

    <section class="bloco">
      <h2>Ferramentas citadas no anúncio</h2>
      <p class="nota">Em quantas vagas cada ferramenta aparece no texto. Uma vaga pode citar várias.</p>
      <ul class="barras" data-barras="ferramentas"></ul>
    </section>

    <div class="trio">
      <section class="bloco">
        <h2>Modelo de trabalho</h2>
        <p class="nota" data-dica="modelo" hidden>Todas as opções, com a escolhida em laranja.</p>
        <ul class="barras curtas" data-barras="modelo"></ul>
      </section>
      <section class="bloco">
        <h2>Área</h2>
        <p class="nota" data-dica="familia" hidden>Todas as opções, com a escolhida em laranja.</p>
        <ul class="barras curtas" data-barras="familia"></ul>
      </section>
      <section class="bloco">
        <h2>Nível</h2>
        <p class="nota" data-dica="nivel" hidden>Todas as opções, com a escolhida em laranja.</p>
        <ul class="barras curtas" data-barras="nivel"></ul>
      </section>
    </div>

    <section class="bloco">
      <h2>Quem mais abriu vagas</h2>
      <p class="nota">Empresas com mais vagas <span data-recorte>na coleta</span>, sem recrutadoras e anúncios confidenciais.</p>
      <ol class="empresas" data-empresas>
        {painel.topEmpresas.map(([nome, n]) => <li><span>{nome}</span><span class="qtd">{n}</span></li>)}
      </ol>
    </section>

    <section class="como" id="como">
      <h2 class="grande">Como funciona</h2>
      <p class="lead">Os números acima saem de um coletor que escrevi para a minha própria busca. Ele não depende de alerta de portal: vai atrás das vagas nas fontes, lê o anúncio inteiro e decide o que entra.</p>

      <Fluxo
        titulo="Uma coleta, da fonte ao painel"
        etapas={[
          { nome: "Catálogo", nota: "1.321 empresas, com o site, a página de carreiras e o sistema de vagas de cada uma." },
          { nome: "Coleta", nota: `${fontes} fontes, sem login, devagar. Cerca de 40 minutos.` },
          { nome: "Filtro", nota: "Nível e área no título, Brasil ou remoto, publicada nos últimos 21 dias." },
          { nome: "Repetidas", nota: "A mesma vaga em três lugares vira uma.", destaque: true },
          { nome: "Sinais", nota: "Regras leem o texto: inglês, modelo, salário, ferramentas." },
          { nome: "Painel", nota: "Sai só o campo derivado. Título, link e texto ficam comigo." },
        ]}
        volta="Cada coleta nova substitui a foto. A triagem vaga a vaga, com IA e memória de descarte, é o Radar de Vagas."
      />

      <div class="detalhes">
        <section>
          <h3>Onde procura</h3>
          <p>Três jeitos de chegar na vaga. Busca por termo nos agregadores: 35 termos no Gupy, 29 no LinkedIn (a página pública, sem conta) e alguns na Sólides. Leitura direta dos sistemas de vagas de cerca de 290 empresas (Greenhouse, Lever, Ashby, InHire e Digai), que publicam a lista completa em JSON. E as páginas de carreira próprias, achadas por um script que percorre o catálogo, adivinha o site, encontra o link de carreiras e identifica qual sistema está embutido ali.</p>
        </section>
        <section>
          <h3>O que entra</h3>
          <p>O título precisa ter as duas coisas: um nível (gerente, head, coordenação, especialista) e uma área compatível (dados, operação, processos, planejamento, receita, IA). E não pode cair numa lista de exclusão: estágio, júnior, vendas de campo, indústria, logística, engenharia de software. Fica a vaga no Brasil ou remota, publicada nas últimas três semanas.</p>
        </section>
        <section>
          <h3>Repetidas</h3>
          <p>A mesma vaga aparece no LinkedIn, no Gupy e no site da empresa. A chave é empresa mais título, sem acento e sem pontuação. Quando há empate, ganha a versão do sistema da própria empresa, que tem a descrição completa e o link direto; depois o LinkedIn, que informa senioridade; por último o Gupy.</p>
        </section>
        <section>
          <h3>Educado com as fontes</h3>
          <p>Uma pausa de 250 a 500 ms entre chamadas e, quando o site pede calma (HTTP 429), espera de 5, 15 e 30 segundos antes de desistir. Nada de login nem de conta falsa. Por isso a coleta completa leva cerca de 40 minutos, e tudo bem: roda enquanto eu faço outra coisa.</p>
        </section>
        <section>
          <h3>Sinais no texto</h3>
          <p>Expressões regulares marcam o que importa na triagem: inglês fluente ou só desejável, o modelo de trabalho que o texto diz (às vezes diferente do campo do portal), Python exigido ou diferencial, vaga de consultoria alocando em cliente, seleção interna. São marcas para ler com atenção, não veredito. Área, nível, ferramentas e salário deste painel saem do mesmo jeito.</p>
        </section>
        <section>
          <h3>O que é público</h3>
          <p>Um exportador lê a coleta na minha máquina e grava só os campos derivados de cada vaga, mais as empresas que mais contratam. Título, link e texto do anúncio nunca saem dele, e os filtros desta página rodam no seu navegador sobre esse arquivo.</p>
        </section>
      </div>

      <div class="limites">
        <h3>Limites</h3>
        <p>A busca é pelo meu perfil, então isto é um recorte do mercado de liderança em operação e dados, não o mercado de dados inteiro. Esta é a coleta de {data(painel.coleta)}, com vagas publicadas entre {data(painel.janela[0])} e {data(painel.janela[1])}. As regras erram nas pontas: "mostra o salário" exige a palavra salário ou remuneração perto do valor, para não contar vale-refeição, e mesmo assim pega uma ou outra. É uma foto, não uma série; a ideia é atualizar a cada coleta e, com o tempo, mostrar o que muda.</p>
        <a class="seta" href={`${base}/cases/radar-de-vagas/`}>Como o Radar faz a triagem vaga a vaga →</a>
      </div>
    </section>
  </main>
</Base>

<script is:inline type="application/json" id="dados-painel" set:html={JSON.stringify({ nomes: painel.nomes, linhas: painel.linhas })}></script>

<script>
  // Mesma regra das páginas de case: a figura se desenha quando entra na tela.
  if (!matchMedia("(prefers-reduced-motion: reduce)").matches && "IntersectionObserver" in window) {
    const obs = new IntersectionObserver((entradas) => {
      entradas.forEach((e) => {
        if (!e.isIntersecting) return;
        (e.target as HTMLElement).dataset.anim = "on";
        obs.unobserve(e.target);
      });
    }, { threshold: 0.3 });
    document.querySelectorAll<HTMLElement>(".fig-anim").forEach((f) => {
      f.dataset.anim = "off";
      obs.observe(f);
    });
  }
</script>

<script>
  type Linha = { e: number | null; familia: string; nivel: string; modelo: string; fonte: string; ferramentas: string[]; ingles: boolean; salario: boolean };
  const { nomes, linhas }: { nomes: string[]; linhas: Linha[] } = JSON.parse(document.getElementById("dados-painel")!.textContent!);
  const selects = [...document.querySelectorAll<HTMLSelectElement>("select[data-filtro]")];
  const limpar = document.querySelector<HTMLButtonElement>(".limpar")!;
  const pct = (n: number, t: number) => (t ? `${Math.round((100 * n) / t)}%` : "–");

  function contar(lista: Linha[], chave: keyof Linha) {
    const m = new Map<string, number>();
    for (const l of lista) for (const v of ([] as unknown[]).concat(l[chave]) as string[]) m.set(v, (m.get(v) ?? 0) + 1);
    return [...m].sort((a, b) => b[1] - a[1]);
  }

  function barras(alvo: string, itens: [string, number][], total: number, limite = 99, marcado = "") {
    const ul = document.querySelector<HTMLUListElement>(`[data-barras="${alvo}"]`)!;
    const max = itens[0]?.[1] || 1;
    ul.innerHTML = "";
    for (const [nome, n] of itens.slice(0, limite)) {
      const li = document.createElement("li");
      li.style.setProperty("--v", String(n / max));
      if (nome === marcado) li.className = "marcado";
      li.innerHTML = `<span class="rot"></span><span class="trilho"><span class="fill"></span></span><span class="val">${n} <small>${pct(n, total)}</small></span>`;
      li.querySelector(".rot")!.textContent = nome;
      ul.append(li);
    }
    if (!itens.length) ul.innerHTML = `<li class="vazio">Nenhuma vaga com esses filtros.</li>`;
  }

  function render() {
    const ativos = selects.filter((s) => s.value);
    const lista = linhas.filter((l) => ativos.every((s) => l[s.dataset.filtro as keyof Linha] === s.value));
    const t = lista.length;
    document.querySelector('[data-n="vagas"]')!.textContent = String(t);
    document.querySelector('[data-n="ingles"]')!.textContent = pct(lista.filter((l) => l.ingles).length, t);
    document.querySelector('[data-n="salario"]')!.textContent = pct(lista.filter((l) => l.salario).length, t);
    const porEmpresa = new Map<number, number>();
    for (const l of lista) if (l.e !== null) porEmpresa.set(l.e, (porEmpresa.get(l.e) ?? 0) + 1);
    document.querySelector('[data-n="empresas"]')!.textContent = String(porEmpresa.size);
    const top = [...porEmpresa].sort((a, b) => b[1] - a[1] || nomes[a[0]].localeCompare(nomes[b[0]])).slice(0, 12);
    const ol = document.querySelector<HTMLOListElement>("[data-empresas]")!;
    ol.innerHTML = "";
    for (const [i, n] of top) {
      const li = document.createElement("li");
      li.innerHTML = `<span></span><span class="qtd">${n}</span>`;
      li.firstElementChild!.textContent = nomes[i];
      ol.append(li);
    }
    if (!top.length) ol.innerHTML = `<li class="vazio">Nenhuma empresa com esses filtros.</li>`;
    document.querySelector("[data-recorte]")!.textContent = ativos.length ? "com os filtros escolhidos" : "na coleta";
    barras("ferramentas", contar(lista, "ferramentas"), t, 15);
    // O gráfico da dimensão filtrada ignora o próprio filtro e destaca a opção escolhida;
    // senão viraria uma barra única de 100%.
    for (const k of ["modelo", "familia", "nivel"] as const) {
      const sel = selects.find((x) => x.dataset.filtro === k)!.value;
      const base = sel ? linhas.filter((l) => ativos.every((x) => x.dataset.filtro === k || l[x.dataset.filtro as keyof Linha] === x.value)) : lista;
      barras(k, contar(base, k), base.length, 99, sel);
      document.querySelector<HTMLElement>(`[data-dica="${k}"]`)!.hidden = !sel;
    }
    limpar.hidden = !ativos.length;
  }

  selects.forEach((s) => s.addEventListener("change", render));
  limpar.addEventListener("click", () => { selects.forEach((s) => (s.value = "")); render(); });
  render();
</script>

<style>
  main { display: flex; flex-direction: column; gap: 40px; padding-block: 32px 88px; }
  .voltar { font-size: 14px; color: var(--muted); text-decoration: none; }
  .voltar:hover { color: var(--ink); }

  .rotulo { margin: 0 0 14px; font-size: 13px; letter-spacing: .06em; text-transform: uppercase; color: var(--muted); }
  h1 {
    margin: 0; max-width: 18ch;
    font-size: clamp(32px, 6vw, 72px); font-weight: 800; font-stretch: 115%;
    line-height: .95; letter-spacing: -.025em; text-transform: uppercase;
  }
  .resumo { margin: 20px 0 0; max-width: 60ch; font-size: 18px; }
  .ancora { display: inline-block; margin-top: 14px; font-weight: 700; color: var(--ink); }

  .filtros { display: flex; flex-wrap: wrap; gap: 12px 16px; align-items: end; }
  .filtros label { display: flex; flex-direction: column; gap: 6px; font-size: 13px; color: var(--muted); }
  .filtros select {
    font: inherit; font-size: 15px; color: var(--ink); background: transparent;
    border: 1px solid var(--ink); border-radius: 0; padding: 8px 32px 8px 10px; min-width: 190px;
    appearance: none; background-image: linear-gradient(45deg, transparent 50%, var(--ink) 50%), linear-gradient(135deg, var(--ink) 50%, transparent 50%);
    background-position: right 14px center, right 9px center; background-size: 5px 5px; background-repeat: no-repeat;
  }
  .limpar { font: inherit; font-size: 14px; background: none; border: 0; padding: 8px 0; text-decoration: underline; cursor: pointer; color: var(--ink); }

  .numeros {
    display: grid; grid-template-columns: repeat(4, minmax(0, 1fr));
    margin: 0; border-block: 1px solid var(--ink);
  }
  .numeros div { padding: 18px 20px 20px 0; border-right: 1px solid var(--line); }
  .numeros div + div { padding-left: 20px; }
  .numeros div:last-child { border-right: 0; }
  .numeros dt { font-size: 13px; color: var(--muted); }
  .numeros dd {
    margin: 6px 0 0;
    font-size: clamp(26px, 3.4vw, 40px); font-weight: 800; font-stretch: 110%;
    line-height: 1; letter-spacing: -.01em; font-variant-numeric: tabular-nums;
  }

  h2 { margin: 0; font-size: 13px; letter-spacing: .06em; text-transform: uppercase; color: var(--muted); font-weight: 600; }
  .nota { margin: 6px 0 0; font-size: 14px; color: var(--muted); }
  .bloco .barras { margin-top: 16px; }

  .trio { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 40px; }

  .barras { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 8px; }
  .barras :global(li) { display: grid; grid-template-columns: 150px minmax(0, 1fr) 84px; gap: 12px; align-items: center; font-size: 15px; }
  .barras.curtas :global(li) { grid-template-columns: 1fr 84px; grid-template-rows: auto 8px; gap: 4px 12px; }
  .barras.curtas :global(.rot) { grid-column: 1; }
  .barras.curtas :global(.trilho) { grid-column: 1 / -1; grid-row: 2; }
  .barras.curtas :global(.val) { grid-column: 2; grid-row: 1; }
  .barras :global(.trilho) { height: 12px; background: var(--line); }
  .barras.curtas :global(.trilho) { height: 8px; }
  .barras :global(.fill) { display: block; height: 100%; width: calc(var(--v) * 100%); background: var(--ink); transition: width .4s ease; }
  .barras :global(.marcado .fill) { background: var(--accent); }
  .barras :global(.marcado .rot) { font-weight: 700; }
  .barras :global(.val) { text-align: right; font-weight: 700; font-variant-numeric: tabular-nums; }
  .barras :global(.val small) { font-weight: 400; color: var(--muted); font-size: 13px; margin-left: 4px; }
  .barras :global(.vazio) { display: block; color: var(--muted); }

  .empresas { list-style: none; margin: 16px 0 0; padding: 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); column-gap: 40px; border-top: 1px solid var(--ink); }
  .empresas :global(li) { display: flex; justify-content: space-between; gap: 12px; padding: 10px 0; border-bottom: 1px solid var(--line); font-size: 17px; font-weight: 700; font-stretch: 105%; }
  .empresas :global(.vazio) { font-weight: 400; color: var(--muted); }
  .empresas :global(.qtd) { font-weight: 400; color: var(--muted); font-variant-numeric: tabular-nums; }

  .como { border-top: 1px solid var(--ink); padding-top: 24px; display: flex; flex-direction: column; gap: 32px; }
  .como .grande { font-size: clamp(26px, 3.4vw, 40px); letter-spacing: -.01em; text-transform: uppercase; color: var(--ink); font-weight: 800; font-stretch: 115%; }
  .lead { margin: -16px 0 0; max-width: 64ch; font-size: 18px; }
  .detalhes { display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 28px 40px; }
  .detalhes section { border-top: 1px solid var(--line); padding-top: 14px; }
  h3 { margin: 0; font-size: 15px; font-weight: 700; }
  .detalhes p, .limites p { margin: 8px 0 0; font-size: 15px; line-height: 1.55; }
  .limites { max-width: 72ch; }
  .limites p { color: var(--muted); font-size: 14px; }
  .limites .seta { display: inline-block; margin-top: 14px; font-weight: 700; color: var(--ink); }

  @media (prefers-reduced-motion: reduce) { .barras :global(.fill) { transition: none; } }

  @media (max-width: 760px) {
    .numeros { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .numeros div:nth-child(2) { border-right: 0; }
    .numeros div + div:nth-child(odd) { padding-left: 0; }
    .numeros div:nth-child(n+3) { border-top: 1px solid var(--line); }
    .trio, .empresas { grid-template-columns: 1fr; }
    .barras :global(li) { grid-template-columns: 110px minmax(0, 1fr) 72px; gap: 8px; font-size: 14px; }
    .filtros label, .filtros select { width: 100%; }
  }
</style>
