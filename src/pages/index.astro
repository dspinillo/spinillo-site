---
import Base from "../layouts/Base.astro";
---
<Base title="Dhiego Spinillo">
  <main>
    <h1>FAÇO A OPERAÇÃO RODAR MELHOR <span>&lt;COM DADOS, AUTOMAÇÃO E IA&gt;</span></h1>
    <p>Dhiego Spinillo. Site em construção.</p>
  </main>
</Base>

<style>
  main {
    max-width: 1080px;
    margin: 0 auto;
    padding-block: 80px;
  }
  h1 {
    margin: 0 0 24px;
    font-size: clamp(36px, 7vw, 72px);
    font-weight: 800;
    font-stretch: 115%;
    line-height: 0.98;
    letter-spacing: -0.02em;
  }
  h1 span { display: block; font-weight: 500; }
  p { color: var(--muted); margin: 0; }
</style>
