---
import { getCollection, render } from "astro:content";
import Base from "../../layouts/Base.astro";
import { indice } from "../../data/trabalhos";
import ForecastSla from "../../components/figuras/ForecastSla.astro";
import Fluxo from "../../components/figuras/Fluxo.astro";
import Barras from "../../components/figuras/Barras.astro";
import Colunas from "../../components/figuras/Colunas.astro";
import Funil from "../../components/figuras/Funil.astro";
import Anotado from "../../components/figuras/Anotado.astro";
import AntesDepois from "../../components/figuras/AntesDepois.astro";
import Arvore from "../../components/figuras/Arvore.astro";

// Figura feita sob medida, pelo id do case. Os outros declaram a figura no frontmatter (campo figura).
const figuras: Record<string, any> = { "sla-bhub": ForecastSla };
const porTipo: Record<string, any> = {
  fluxo: Fluxo, barras: Barras, colunas: Colunas, funil: Funil, anotado: Anotado, antesdepois: AntesDepois, arvore: Arvore,
};

export async function getStaticPaths() {
  const cases = await getCollection("cases");
  return cases.map((c) => ({ params: { id: c.id }, props: { caso: c } }));
}

const { caso } = Astro.props;
const { Content } = await render(caso);
const base = import.meta.env.BASE_URL.replace(/\/$/, "");

const pos = indice.findIndex((t) => t.caso === caso.id);
if (pos < 0) throw new Error(`Case "${caso.id}" não está em src/data/trabalhos.ts`);
const item = indice[pos];

// Vizinhos só entre trabalhos que já têm página, na ordem do índice.
const publicados = new Set((await getCollection("cases")).map((c) => c.id));
const comCaso = indice.filter((t) => t.caso && publicados.has(t.caso));
const aqui = comCaso.findIndex((t) => t.caso === caso.id);
const anterior = comCaso[aqui - 1];
const proximo = comCaso[aqui + 1];
const { titulo, resumo, periodo, numeros, links, sintese, stack, quebrou, confiabilidade, figura } = caso.data;
const Figura = figuras[caso.id] ?? (figura && porTipo[figura.tipo]);
const cartoes = [
  quebrou && { rotulo: "O que quebrou", ...quebrou },
  confiabilidade && { rotulo: "Confiabilidade", ...confiabilidade },
].filter((c) => c && !c.texto.startsWith("[Para você preencher")) as { rotulo: string; titulo?: string; texto: string }[];
// Número que conta até o valor: só quando o valor tem um número só ("60%", "170 mil+").
const contavel = (v: string) => (v.match(/\d+(?:[.,]\d+)?/g) ?? []).length === 1;
---
<Base title={`${titulo} · Dhiego Spinillo`} description={resumo}>
  <main>
    <a class="voltar" href={`${base}/#${item.pilar.id}`}><span aria-hidden="true">←</span> Índice</a>

    <header class="topo-caso">
      <p class="rotulo">
        <span>({item.n})</span>
        <a href={`${base}/#${item.pilar.id}`}>{item.pilar.verbo}</a>
        <span>{item.onde}</span>
        <span>{periodo}</span>
      </p>
      <h1>{titulo}</h1>
      {sintese ? (
        <dl class="sintese">
          <div><dt>Problema</dt><dd>{sintese.problema}</dd></div>
          <div><dt>O que fiz</dt><dd>{sintese.feito}</dd></div>
          <div><dt>Resultado</dt><dd>{sintese.resultado}</dd></div>
        </dl>
      ) : (
        <p class="resumo">{resumo}</p>
      )}
    </header>

    <dl class="numeros">
      {numeros.map((x) => (
        <div>
          <dt>{x.rotulo}</dt>
          <dd data-contar={contavel(x.valor) ? "" : undefined}>{x.valor}</dd>
        </div>
      ))}
    </dl>

    {Figura && <Figura {...figura} />}

    {stack.length > 0 && (
      <ul class="stack" aria-label="Ferramentas">
        {stack.map((f) => <li>{f}</li>)}
      </ul>
    )}

    <article class="corpo">
      <Content />
    </article>

    {cartoes.length > 0 && (
      <div class="cartoes">
        {cartoes.map((c) => (
          <section>
            <h2>{c.rotulo}</h2>
            {c.titulo && <p class="cartao-titulo">{c.titulo}</p>}
            <p>{c.texto}</p>
          </section>
        ))}
      </div>
    )}

    {links.length > 0 && (
      <ul class="links">
        {links.map((l) => (
          <li><a href={l.url} target="_blank" rel="noopener">{l.rotulo} <span aria-hidden="true">↗</span></a></li>
        ))}
      </ul>
    )}

    <nav class="vizinhos" aria-label="Outros trabalhos">
      {anterior ? (
        <a href={`${base}/cases/${anterior.caso}/`}>
          <span class="dir"><span aria-hidden="true">←</span> Anterior</span>
          <span class="nome">{anterior.titulo}</span>
        </a>
      ) : <span />}
      {proximo && (
        <a class="prox" href={`${base}/cases/${proximo.caso}/`}>
          <span class="dir">Próximo <span aria-hidden="true">→</span></span>
          <span class="nome">{proximo.titulo}</span>
        </a>
      )}
    </nav>
  </main>
</Base>

<script>
  // Figuras com .fig-anim começam recolhidas e se desenham quando entram na tela.
  if (!matchMedia("(prefers-reduced-motion: reduce)").matches && "IntersectionObserver" in window) {
    const obs = new IntersectionObserver((entradas) => {
      entradas.forEach((e) => {
        if (!e.isIntersecting) return;
        (e.target as HTMLElement).dataset.anim = "on";
        obs.unobserve(e.target);
      });
    }, { threshold: 0.3 });
    document.querySelectorAll<HTMLElement>(".fig-anim").forEach((f) => {
      f.dataset.anim = "off";
      obs.observe(f);
    });
  }
</script>

<script>
  // Os números da faixa contam do zero até o valor quando entram na tela.
  const dds = document.querySelectorAll<HTMLElement>(".numeros dd[data-contar]");
  if (dds.length && !matchMedia("(prefers-reduced-motion: reduce)").matches && "IntersectionObserver" in window) {
    const formata = (n: number, casas: number) => n.toLocaleString("pt-BR", { minimumFractionDigits: casas, maximumFractionDigits: casas });
    const obs = new IntersectionObserver((entradas) => {
      entradas.forEach((e) => {
        if (!e.isIntersecting) return;
        obs.unobserve(e.target);
        const el = e.target as HTMLElement;
        const texto = el.textContent ?? "";
        const m = texto.match(/\d+(?:[.,]\d+)?/)!;
        const casas = m[0].includes(",") ? m[0].split(",")[1].length : 0;
        const alvo = parseFloat(m[0].replace(".", "").replace(",", "."));
        const [antes, depois] = [texto.slice(0, m.index), texto.slice(m.index! + m[0].length)];
        const inicio = performance.now();
        const passo = (t: number) => {
          const k = Math.min(1, (t - inicio) / 900);
          const v = alvo * (1 - Math.pow(1 - k, 3));
          el.textContent = antes + formata(k < 1 ? v : alvo, casas) + depois;
          if (k < 1) requestAnimationFrame(passo);
          else el.textContent = texto;
        };
        requestAnimationFrame(passo);
      });
    }, { threshold: 0.6 });
    dds.forEach((d) => obs.observe(d));
  }
</script>

<style>
  main { display: flex; flex-direction: column; gap: 48px; padding-block: 24px 88px; }

  .voltar { align-self: flex-start; font-size: 14px; color: var(--muted); text-decoration: none; }
  .voltar:hover { color: var(--ink); }

  .topo-caso { display: flex; flex-direction: column; gap: 20px; }
  .rotulo {
    display: flex; flex-wrap: wrap; gap: 6px 20px; margin: 0;
    font-size: 13px; letter-spacing: .06em; text-transform: uppercase; color: var(--muted);
  }
  .rotulo a { text-decoration: none; color: var(--ink); font-weight: 600; }
  .rotulo a:hover { text-decoration: underline; }
  h1 {
    margin: 0;
    font-size: clamp(34px, 7vw, 84px);
    font-weight: 800; font-stretch: 115%;
    line-height: .95; letter-spacing: -.025em;
    text-transform: uppercase; text-wrap: balance;
  }
  .resumo { margin: 0; max-width: 60ch; font-size: clamp(18px, 2vw, 21px); line-height: 1.45; }

  .sintese {
    display: grid; grid-template-columns: minmax(0, 1fr); gap: 16px;
    margin: 4px 0 0; max-width: 980px;
  }
  @media (min-width: 861px) {
    .sintese { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 24px 32px; }
  }
  .sintese dt { font-size: 13px; letter-spacing: .06em; text-transform: uppercase; color: var(--muted); }
  .sintese dd { margin: 8px 0 0; font-size: clamp(17px, 1.8vw, 20px); line-height: 1.4; text-wrap: pretty; }
  .sintese div:last-child dd { font-weight: 700; }

  .stack { display: flex; flex-wrap: wrap; gap: 8px; list-style: none; margin: -24px 0 0; padding: 0; }
  .stack li {
    font-size: 12px; font-weight: 600; letter-spacing: .04em; text-transform: uppercase;
    padding: 5px 10px; border: 1px solid var(--line); border-radius: 999px; color: var(--muted);
  }

  .corpo :global(blockquote) {
    grid-column: 2; margin: 40px 0 0; padding: 0 0 0 20px; border-left: 3px solid var(--accent);
  }
  .corpo :global(blockquote p) {
    margin: 0; font-size: clamp(22px, 2.6vw, 30px); font-weight: 700; font-stretch: 110%;
    line-height: 1.15; letter-spacing: -.01em; text-wrap: balance;
  }

  .cartoes { display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 16px; }
  .cartoes section { padding: 20px 22px 22px; border: 1px solid var(--line); border-radius: 4px; }
  .cartoes h2 { margin: 0; font-size: 13px; font-weight: 700; letter-spacing: .06em; text-transform: uppercase; color: var(--muted); }
  .cartoes .cartao-titulo { margin: 12px 0 0; font-weight: 700; }
  .cartoes p { margin: 8px 0 0; max-width: 60ch; }

  .numeros {
    display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    margin: 0; border-block: 1px solid var(--ink);
  }
  .numeros div { padding: 18px 20px 20px 0; border-right: 1px solid var(--line); }
  .numeros div + div { padding-left: 20px; }
  .numeros div:last-child { border-right: 0; }
  .numeros dt { font-size: 13px; color: var(--muted); }
  .numeros dd {
    margin: 6px 0 0;
    font-size: clamp(26px, 3.4vw, 40px); font-weight: 800; font-stretch: 110%;
    line-height: 1; letter-spacing: -.01em; font-variant-numeric: tabular-nums;
  }

  .corpo {
    display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 2.2fr);
    column-gap: 40px;
  }
  .corpo :global(h2) {
    grid-column: 1;
    margin: 0; padding-top: 20px; border-top: 1px solid var(--line);
    font-size: 15px; font-weight: 700; letter-spacing: .06em; text-transform: uppercase;
  }
  .corpo :global(p), .corpo :global(ul) { margin: 14px 0 0; }
  .corpo :global(h2 ~ *:not(h2)) { grid-column: 2; max-width: 64ch; }
  .corpo :global(h2 + *) { margin-top: 0; padding-top: 20px; border-top: 1px solid var(--line); }
  .corpo :global(h2:not(:first-child)), .corpo :global(h2:not(:first-child) + *) { margin-top: 40px; }
  .corpo :global(ul) { padding-left: 1.1em; }
  .corpo :global(li + li) { margin-top: 6px; }
  .corpo :global(strong) { font-weight: 700; }
  .corpo :global(code) { font-size: .92em; }

  .links { display: flex; flex-wrap: wrap; gap: 10px; list-style: none; margin: 0; padding: 0; }
  .links a {
    display: inline-flex; gap: 8px; padding: 11px 18px; border-radius: 999px;
    background: var(--ink); color: var(--bg);
    font-size: 14px; font-weight: 600; text-decoration: none;
  }
  .links a:hover { opacity: .85; }

  .vizinhos {
    display: grid; grid-template-columns: 1fr 1fr; gap: 24px;
    border-top: 1px solid var(--ink); padding-top: 20px;
  }
  .vizinhos a { display: flex; flex-direction: column; gap: 6px; text-decoration: none; }
  .vizinhos .prox { grid-column: 2; text-align: right; align-items: flex-end; }
  .vizinhos .dir { font-size: 13px; color: var(--muted); }
  .vizinhos .nome {
    font-size: clamp(17px, 2vw, 22px); font-weight: 500; font-stretch: 110%; text-transform: uppercase;
  }
  .vizinhos a:hover .nome { text-decoration: underline; }

  @media (max-width: 860px) {
    h1 { font-stretch: 100%; }
    .corpo :global(blockquote) { grid-column: 1; }
    .corpo { grid-template-columns: minmax(0, 1fr); }
    .corpo :global(h2), .corpo :global(h2 ~ *:not(h2)) { grid-column: 1; }
    .corpo :global(h2 + *) { border-top: 0; padding-top: 0; margin-top: 12px !important; }
    .sintese {
    display: grid; grid-template-columns: minmax(0, 1fr); gap: 16px;
    margin: 4px 0 0; max-width: 980px;
  }
  @media (min-width: 861px) {
    .sintese { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 24px 32px; }
  }
  .sintese dt { font-size: 13px; letter-spacing: .06em; text-transform: uppercase; color: var(--muted); }
  .sintese dd { margin: 8px 0 0; font-size: clamp(17px, 1.8vw, 20px); line-height: 1.4; text-wrap: pretty; }
  .sintese div:last-child dd { font-weight: 700; }

  .stack { display: flex; flex-wrap: wrap; gap: 8px; list-style: none; margin: -24px 0 0; padding: 0; }
  .stack li {
    font-size: 12px; font-weight: 600; letter-spacing: .04em; text-transform: uppercase;
    padding: 5px 10px; border: 1px solid var(--line); border-radius: 999px; color: var(--muted);
  }

  .corpo :global(blockquote) {
    grid-column: 2; margin: 40px 0 0; padding: 0 0 0 20px; border-left: 3px solid var(--accent);
  }
  .corpo :global(blockquote p) {
    margin: 0; font-size: clamp(22px, 2.6vw, 30px); font-weight: 700; font-stretch: 110%;
    line-height: 1.15; letter-spacing: -.01em; text-wrap: balance;
  }

  .cartoes { display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 16px; }
  .cartoes section { padding: 20px 22px 22px; border: 1px solid var(--line); border-radius: 4px; }
  .cartoes h2 { margin: 0; font-size: 13px; font-weight: 700; letter-spacing: .06em; text-transform: uppercase; color: var(--muted); }
  .cartoes .cartao-titulo { margin: 12px 0 0; font-weight: 700; }
  .cartoes p { margin: 8px 0 0; max-width: 60ch; }

  .numeros { grid-template-columns: 1fr 1fr; }
    .numeros div { padding: 14px 12px 16px 0; border-right: 0; border-bottom: 1px solid var(--line); }
    .numeros div + div { padding-left: 0; }
    .numeros div:nth-child(2n) { padding-left: 12px; border-left: 1px solid var(--line); }
    .numeros div:nth-last-child(-n + 2):nth-child(odd), .numeros div:last-child { border-bottom: 0; }
  }
</style>
