---
import { getCollection, render } from "astro:content";
import Base from "../../layouts/Base.astro";
import { indice } from "../../data/trabalhos";

export async function getStaticPaths() {
  const cases = await getCollection("cases");
  return cases.map((c) => ({ params: { id: c.id }, props: { caso: c } }));
}

const { caso } = Astro.props;
const { Content } = await render(caso);
const base = import.meta.env.BASE_URL.replace(/\/$/, "");

const pos = indice.findIndex((t) => t.caso === caso.id);
if (pos < 0) throw new Error(`Case "${caso.id}" não está em src/data/trabalhos.ts`);
const item = indice[pos];

// Vizinhos só entre trabalhos que já têm página, na ordem do índice.
const publicados = new Set((await getCollection("cases")).map((c) => c.id));
const comCaso = indice.filter((t) => t.caso && publicados.has(t.caso));
const aqui = comCaso.findIndex((t) => t.caso === caso.id);
const anterior = comCaso[aqui - 1];
const proximo = comCaso[aqui + 1];
const { titulo, resumo, periodo, numeros, links } = caso.data;
---
<Base title={`${titulo} · Dhiego Spinillo`} description={resumo}>
  <main>
    <a class="voltar" href={`${base}/#${item.pilar.id}`}><span aria-hidden="true">←</span> Índice</a>

    <header class="topo-caso">
      <p class="rotulo">
        <span>({item.n})</span>
        <a href={`${base}/#${item.pilar.id}`}>{item.pilar.verbo}</a>
        <span>{item.onde}</span>
        <span>{periodo}</span>
      </p>
      <h1>{titulo}</h1>
      <p class="resumo">{resumo}</p>
    </header>

    <dl class="numeros">
      {numeros.map((x) => (
        <div>
          <dt>{x.rotulo}</dt>
          <dd>{x.valor}</dd>
        </div>
      ))}
    </dl>

    <article class="corpo">
      <Content />
    </article>

    {links.length > 0 && (
      <ul class="links">
        {links.map((l) => (
          <li><a href={l.url} target="_blank" rel="noopener">{l.rotulo} <span aria-hidden="true">↗</span></a></li>
        ))}
      </ul>
    )}

    <nav class="vizinhos" aria-label="Outros trabalhos">
      {anterior ? (
        <a href={`${base}/cases/${anterior.caso}/`}>
          <span class="dir"><span aria-hidden="true">←</span> Anterior</span>
          <span class="nome">{anterior.titulo}</span>
        </a>
      ) : <span />}
      {proximo && (
        <a class="prox" href={`${base}/cases/${proximo.caso}/`}>
          <span class="dir">Próximo <span aria-hidden="true">→</span></span>
          <span class="nome">{proximo.titulo}</span>
        </a>
      )}
    </nav>
  </main>
</Base>

<style>
  main { display: flex; flex-direction: column; gap: 48px; padding-block: 24px 88px; }

  .voltar { align-self: flex-start; font-size: 14px; color: var(--muted); text-decoration: none; }
  .voltar:hover { color: var(--ink); }

  .topo-caso { display: flex; flex-direction: column; gap: 20px; }
  .rotulo {
    display: flex; flex-wrap: wrap; gap: 6px 20px; margin: 0;
    font-size: 13px; letter-spacing: .06em; text-transform: uppercase; color: var(--muted);
  }
  .rotulo a { text-decoration: none; color: var(--ink); font-weight: 600; }
  .rotulo a:hover { text-decoration: underline; }
  h1 {
    margin: 0;
    font-size: clamp(34px, 7vw, 84px);
    font-weight: 800; font-stretch: 115%;
    line-height: .95; letter-spacing: -.025em;
    text-transform: uppercase; text-wrap: balance;
  }
  .resumo { margin: 0; max-width: 60ch; font-size: clamp(18px, 2vw, 21px); line-height: 1.45; }

  .numeros {
    display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    margin: 0; border-block: 1px solid var(--ink);
  }
  .numeros div { padding: 18px 20px 20px 0; border-right: 1px solid var(--line); }
  .numeros div + div { padding-left: 20px; }
  .numeros div:last-child { border-right: 0; }
  .numeros dt { font-size: 13px; color: var(--muted); }
  .numeros dd {
    margin: 6px 0 0;
    font-size: clamp(26px, 3.4vw, 40px); font-weight: 800; font-stretch: 110%;
    line-height: 1; letter-spacing: -.01em; font-variant-numeric: tabular-nums;
  }

  .corpo {
    display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 2.2fr);
    column-gap: 40px;
  }
  .corpo :global(h2) {
    grid-column: 1;
    margin: 0; padding-top: 20px; border-top: 1px solid var(--line);
    font-size: 15px; font-weight: 700; letter-spacing: .06em; text-transform: uppercase;
  }
  .corpo :global(p), .corpo :global(ul) { margin: 14px 0 0; }
  .corpo :global(h2 ~ *:not(h2)) { grid-column: 2; max-width: 64ch; }
  .corpo :global(h2 + *) { margin-top: 0; padding-top: 20px; border-top: 1px solid var(--line); }
  .corpo :global(h2:not(:first-child)), .corpo :global(h2:not(:first-child) + *) { margin-top: 40px; }
  .corpo :global(ul) { padding-left: 1.1em; }
  .corpo :global(li + li) { margin-top: 6px; }
  .corpo :global(strong) { font-weight: 700; }
  .corpo :global(code) { font-size: .92em; }

  .links { display: flex; flex-wrap: wrap; gap: 10px; list-style: none; margin: 0; padding: 0; }
  .links a {
    display: inline-flex; gap: 8px; padding: 11px 18px; border-radius: 999px;
    background: var(--ink); color: var(--bg);
    font-size: 14px; font-weight: 600; text-decoration: none;
  }
  .links a:hover { opacity: .85; }

  .vizinhos {
    display: grid; grid-template-columns: 1fr 1fr; gap: 24px;
    border-top: 1px solid var(--ink); padding-top: 20px;
  }
  .vizinhos a { display: flex; flex-direction: column; gap: 6px; text-decoration: none; }
  .vizinhos .prox { grid-column: 2; text-align: right; align-items: flex-end; }
  .vizinhos .dir { font-size: 13px; color: var(--muted); }
  .vizinhos .nome {
    font-size: clamp(17px, 2vw, 22px); font-weight: 500; font-stretch: 110%; text-transform: uppercase;
  }
  .vizinhos a:hover .nome { text-decoration: underline; }

  @media (max-width: 860px) {
    h1 { font-stretch: 100%; }
    .corpo { grid-template-columns: minmax(0, 1fr); }
    .corpo :global(h2), .corpo :global(h2 ~ *:not(h2)) { grid-column: 1; }
    .corpo :global(h2 + *) { border-top: 0; padding-top: 0; margin-top: 12px !important; }
    .numeros { grid-template-columns: 1fr 1fr; }
    .numeros div { padding: 14px 12px 16px 0; border-right: 0; border-bottom: 1px solid var(--line); }
    .numeros div + div { padding-left: 0; }
    .numeros div:nth-child(2n) { padding-left: 12px; border-left: 1px solid var(--line); }
    .numeros div:nth-last-child(-n + 2):nth-child(odd), .numeros div:last-child { border-bottom: 0; }
  }
</style>
