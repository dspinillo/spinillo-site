---
// Funil horizontal: cada etapa é uma barra centralizada que afina (largura de 0 a 1),
// com a nota ao lado. A etapa em destaque sai em laranja.
interface Props {
  titulo: string;
  etapas: { nome: string; nota?: string; destaque?: boolean; largura?: number }[];
  legenda?: string;
}
const { titulo, etapas, legenda } = Astro.props;
---
<figure class="funil fig-anim">
  <p class="tit">{titulo}</p>
  <ol>
    {etapas.map((e, i) => (
      <li class:list={{ destaque: e.destaque }} style={`--l:${e.largura ?? 1 - i * 0.18};--i:${i}`}>
        <span class="faixa"><span class="barra"><strong>{e.nome}</strong></span></span>
        {e.nota && <span class="nota">{e.nota}</span>}
      </li>
    ))}
  </ol>
  {legenda && <figcaption>{legenda}</figcaption>}
</figure>

<style>
  .funil { margin: 0; display: flex; flex-direction: column; gap: 18px; }
  .tit { margin: 0; font-size: 13px; letter-spacing: .06em; text-transform: uppercase; color: var(--muted); }
  ol { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 6px; }
  li { display: grid; grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr); gap: 24px; align-items: center; }
  .faixa { display: flex; justify-content: center; }
  .barra {
    display: flex; align-items: center; justify-content: center;
    width: calc(var(--l) * 100%); min-height: 54px; padding: 0 12px;
    background: var(--ink); color: var(--bg);
    transition: width .7s cubic-bezier(.2, .7, .2, 1); transition-delay: calc(var(--i) * 140ms);
  }
  .barra strong { font-size: 15px; font-weight: 700; letter-spacing: .04em; text-transform: uppercase; white-space: nowrap; transition: opacity .3s; transition-delay: calc(var(--i) * 140ms + .4s); }
  .destaque .barra { background: var(--accent); }
  .nota { font-size: 14px; line-height: 1.4; color: var(--muted); border-left: 1px solid var(--line); padding-left: 16px; transition: opacity .5s; transition-delay: calc(var(--i) * 140ms + .3s); }
  .destaque .nota { color: var(--ink); border-left-color: var(--accent); }
  figcaption { max-width: 64ch; font-size: 13px; line-height: 1.5; color: var(--muted); }

  [data-anim="off"] .barra { width: 0; }
  [data-anim="off"] .barra strong, [data-anim="off"] .nota { opacity: 0; }

  @media (max-width: 700px) {
    li { grid-template-columns: minmax(0, 1fr); gap: 6px; margin-bottom: 10px; }
    .barra { min-height: 44px; }
    .nota { border-left: 0; padding-left: 0; text-align: center; }
  }
  @media (prefers-reduced-motion: reduce) { .barra, .barra strong, .nota { transition: none; } }
</style>
