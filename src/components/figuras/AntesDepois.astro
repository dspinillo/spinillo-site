---
// Duas colunas: o antes, bagunçado (itens tortos), e o depois, em ordem.
// Cada item é "nome | detalhe"; o detalhe sai menor, ao lado.
interface Lado { titulo: string; itens: string[] }
interface Props { titulo: string; antes: Lado; depois: Lado; legenda?: string }
const { titulo, antes, depois, legenda } = Astro.props;
const parte = (s: string) => s.split("|").map((x) => x.trim());
// Inclinação e deslocamento fixos por posição, para a bagunça ser sempre a mesma.
const torto = [-2.5, 1.8, -1, 2.6, -1.8, 1.2, -2.2];
const desloca = [0, 18, 6, 26, 10, 30, 4];
---
<figure class="ad fig-anim">
  <p class="tit">{titulo}</p>
  <div class="lados">
    <section class="antes">
      <h3>{antes.titulo}</h3>
      <ul>
        {antes.itens.map((x, i) => {
          const [nome, det] = parte(x);
          return (
            <li style={`--r:${torto[i % torto.length]}deg;--x:${desloca[i % desloca.length]}px;--i:${i}`}>
              <code>{nome}</code>{det && <span>{det}</span>}
            </li>
          );
        })}
      </ul>
    </section>
    <span class="seta" aria-hidden="true">→</span>
    <section class="depois">
      <h3>{depois.titulo}</h3>
      <ul>
        {depois.itens.map((x, i) => {
          const [nome, det] = parte(x);
          return (
            <li style={`--i:${i + antes.itens.length}`}>
              <code>{nome}</code>{det && <span>{det}</span>}
            </li>
          );
        })}
      </ul>
    </section>
  </div>
  {legenda && <figcaption>{legenda}</figcaption>}
</figure>

<style>
  .ad { margin: 0; display: flex; flex-direction: column; gap: 18px; }
  .tit { margin: 0; font-size: 13px; letter-spacing: .06em; text-transform: uppercase; color: var(--muted); }
  .lados { display: grid; grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr); gap: 24px; align-items: center; }
  h3 { margin: 0 0 14px; font-size: 13px; font-weight: 700; letter-spacing: .06em; text-transform: uppercase; }
  ul { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 8px; }
  li {
    display: flex; flex-wrap: wrap; align-items: baseline; gap: 4px 10px;
    padding: 10px 14px; border: 1px solid var(--line); border-radius: 4px; background: var(--bg);
    transition: opacity .4s, transform .5s cubic-bezier(.2, .7, .2, 1); transition-delay: calc(var(--i) * 90ms);
  }
  code { font-family: ui-monospace, "SF Mono", Menlo, monospace; font-size: 13px; }
  li span { font-size: 12px; color: var(--muted); }

  .antes li { transform: translateX(var(--x)) rotate(var(--r)); border-style: dashed; }
  .antes code { color: var(--muted); }
  .depois li { border-color: var(--ink); }
  .depois li:first-child { border-left: 4px solid var(--accent); }
  .seta { font-size: 28px; color: var(--muted); }

  figcaption { max-width: 64ch; font-size: 13px; line-height: 1.5; color: var(--muted); }

  [data-anim="off"] li { opacity: 0; }
  [data-anim="off"] .antes li { transform: translateX(var(--x)) rotate(0) translateY(-10px); }
  [data-anim="off"] .depois li { transform: translateX(12px); }

  @media (max-width: 760px) {
    .lados { grid-template-columns: minmax(0, 1fr); gap: 16px; }
    .seta { transform: rotate(90deg); justify-self: center; }
    .antes ul { padding-right: 12px; }
    .antes li { transform: translateX(calc(var(--x) / 3)) rotate(calc(var(--r) * .6)); }
  }
  @media (prefers-reduced-motion: reduce) { li { transition: none; } }
</style>
