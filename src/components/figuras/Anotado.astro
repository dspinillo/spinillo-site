---
// Um exemplo de texto com trechos marcados por tipo: [[trecho|tipo]]. A legenda diz o que cada tipo é.
// Os marcadores acendem em sequência quando a figura entra na tela.
type Tom = "ink" | "faint" | "accent";
interface Props {
  titulo: string;
  cabecalho?: string;
  paragrafos: string[];
  marcas: { tipo: string; rotulo: string; tom?: Tom }[];
  legenda?: string;
}
const { titulo, cabecalho, paragrafos, marcas, legenda } = Astro.props;
const tomDe = Object.fromEntries(marcas.map((m) => [m.tipo, m.tom ?? "ink"]));
const esc = (t: string) => t.replace(/[&<>]/g, (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;" })[c]!);
let i = 0;
const html = (p: string) =>
  esc(p).replace(/\[\[(.+?)\|(.+?)\]\]/g, (_, txt, tipo) => `<mark class="m-${tomDe[tipo] ?? "ink"}" style="--i:${i++}">${txt}</mark>`);
---
<figure class="anotado fig-anim">
  <p class="tit">{titulo}</p>
  <div class="caixa">
    <div class="doc">
      {cabecalho && <p class="cab">{cabecalho}</p>}
      {paragrafos.map((p) => <p set:html={html(p)} />)}
    </div>
    <ul class="chaves">
      {marcas.map((m) => (
        <li><span class:list={["amostra", `m-${m.tom ?? "ink"}`]} />{m.rotulo}</li>
      ))}
    </ul>
  </div>
  {legenda && <figcaption>{legenda}</figcaption>}
</figure>

<style>
  .anotado { margin: 0; display: flex; flex-direction: column; gap: 18px; }
  .tit { margin: 0; font-size: 13px; letter-spacing: .06em; text-transform: uppercase; color: var(--muted); }
  .caixa { display: grid; grid-template-columns: minmax(0, 2fr) minmax(0, 1fr); gap: 32px; align-items: start; }
  .doc {
    padding: 24px 26px; border: 1px solid var(--ink); border-radius: 4px;
    font-size: clamp(16px, 1.6vw, 18px); line-height: 1.6;
  }
  .doc p { margin: 0; }
  .doc p + p { margin-top: 12px; }
  .cab { font-size: 13px; letter-spacing: .06em; text-transform: uppercase; color: var(--muted); margin-bottom: 14px !important; }

  .doc :global(mark) {
    color: inherit; background-color: transparent; padding: 0 2px; background-repeat: no-repeat; background-position: 0 100%;
    transition: background-size .5s cubic-bezier(.2, .7, .2, 1); transition-delay: calc(var(--i) * 120ms + .2s);
    background-size: 100% 100%;
  }
  .doc :global(mark.m-ink) { background-image: linear-gradient(color-mix(in srgb, var(--ink) 14%, transparent), color-mix(in srgb, var(--ink) 14%, transparent)); box-shadow: inset 0 -2px 0 var(--ink); }
  .doc :global(mark.m-faint) { background-image: none; box-shadow: inset 0 -1px 0 var(--faint); }
  .doc :global(mark.m-accent) { background-image: linear-gradient(color-mix(in srgb, var(--accent) 22%, transparent), color-mix(in srgb, var(--accent) 22%, transparent)); box-shadow: inset 0 -2px 0 var(--accent); }

  .chaves { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 14px; font-size: 14px; line-height: 1.4; }
  .chaves li { display: flex; gap: 10px; align-items: baseline; }
  .amostra { flex: none; width: 22px; height: 12px; transform: translateY(1px); }
  .amostra.m-ink { background: color-mix(in srgb, var(--ink) 14%, transparent); border-bottom: 2px solid var(--ink); }
  .amostra.m-faint { border-bottom: 1px solid var(--faint); }
  .amostra.m-accent { background: color-mix(in srgb, var(--accent) 22%, transparent); border-bottom: 2px solid var(--accent); }

  figcaption { max-width: 64ch; font-size: 13px; line-height: 1.5; color: var(--muted); }

  [data-anim="off"] .doc :global(mark) { background-size: 0 100%; box-shadow: none; }

  @media (max-width: 760px) {
    .caixa { grid-template-columns: minmax(0, 1fr); gap: 18px; }
    .doc { padding: 18px; }
  }
  @media (prefers-reduced-motion: reduce) { .doc :global(mark) { transition: none; } }
</style>
