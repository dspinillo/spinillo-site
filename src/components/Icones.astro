---
const links = [
  {
    nome: "LinkedIn",
    href: "https://www.linkedin.com/in/dspinillo",
    path: "M4.98 3.5C4.98 4.88 3.87 6 2.5 6S0 4.88 0 3.5 1.12 1 2.5 1s2.48 1.12 2.48 2.5zM.22 8.02h4.56V23H.22V8.02zM8.12 8.02h4.37v2.05h.06c.61-1.15 2.1-2.37 4.32-2.37 4.62 0 5.47 3.04 5.47 7V23h-4.55v-7.24c0-1.73-.03-3.95-2.4-3.95-2.41 0-2.78 1.88-2.78 3.82V23H8.12V8.02z",
  },
  {
    nome: "GitHub",
    href: "https://github.com/dspinillo",
    path: "M12 .5a11.5 11.5 0 0 0-3.64 22.41c.58.1.79-.25.79-.56v-2c-3.2.7-3.88-1.54-3.88-1.54-.52-1.33-1.28-1.68-1.28-1.68-1.05-.72.08-.7.08-.7 1.16.08 1.77 1.19 1.77 1.19 1.03 1.77 2.7 1.26 3.36.96.1-.75.4-1.26.73-1.55-2.56-.29-5.25-1.28-5.25-5.69 0-1.26.45-2.29 1.19-3.09-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.17 1.18a11 11 0 0 1 5.77 0c2.2-1.49 3.17-1.18 3.17-1.18.63 1.59.23 2.76.11 3.05.74.8 1.19 1.83 1.19 3.09 0 4.42-2.7 5.39-5.27 5.68.41.36.78 1.06.78 2.14v3.17c0 .31.21.67.8.56A11.5 11.5 0 0 0 12 .5Z",
  },
];
---
<ul class="icones">
  {links.map((l) => (
    <li>
      <a href={l.href} rel="me noopener" target="_blank" aria-label={l.nome} title={l.nome}>
        <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><path fill="currentColor" d={l.path} /></svg>
      </a>
    </li>
  ))}
</ul>

<style>
  .icones { display: flex; gap: 8px; list-style: none; margin: 0; padding: 0; }
  a {
    display: grid; place-items: center;
    width: 36px; height: 36px; border-radius: 50%;
    border: 1px solid var(--ink); color: var(--ink);
    transition: background-color .15s, color .15s;
  }
  a:hover, a:focus-visible { background: var(--ink); color: var(--bg); }
  a:focus-visible { outline: 2px solid var(--ink); outline-offset: 2px; }
</style>
